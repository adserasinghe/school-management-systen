generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  teacher
  student

  @@map("user_role")
}

enum Gender {
  male
  female
  other
  prefer_not_to_say

  @@map("gender")
}

enum PersonStatus {
  active
  inactive

  @@map("person_status")
}

enum StudentStatus {
  active
  inactive
  graduated

  @@map("student_status")
}

enum TeacherAttendanceStatus {
  present
  absent
  late
  leave

  @@map("teacher_attendance_status")
}

enum StudentAttendanceStatus {
  present
  absent
  late
  excused

  @@map("student_attendance_status")
}

model User {
  id                     String              @id @default(uuid()) @db.Uuid
  username               String              @unique @db.VarChar(50)
  email                  String              @unique @db.VarChar(255)
  passwordHash           String              @map("password_hash") @db.VarChar(255)
  role                   UserRole
  isActive               Boolean             @default(true) @map("is_active")
  lastLoginAt            DateTime?           @map("last_login_at")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  teacherProfile         Teacher?
  studentProfile         Student?
  markedTeacherAttendance TeacherAttendance[] @relation("TeacherAttendanceMarkedBy")
  markedStudentAttendance StudentAttendance[] @relation("StudentAttendanceMarkedBy")
  enteredMarks           Mark[]              @relation("MarksEnteredBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Teacher {
  id                    String              @id @default(uuid()) @db.Uuid
  userId                String              @unique @map("user_id") @db.Uuid
  teacherCode           String              @unique @map("teacher_code") @db.VarChar(30)
  firstName             String              @map("first_name") @db.VarChar(100)
  lastName              String              @map("last_name") @db.VarChar(100)
  gender                Gender?
  dateOfBirth           DateTime?           @map("date_of_birth") @db.Date
  phone                 String?             @db.VarChar(30)
  address               String?             @db.VarChar(500)
  qualification         String?             @db.VarChar(255)
  subjectSpecialization String?             @map("subject_specialization") @db.VarChar(255)
  hireDate              DateTime?           @map("hire_date") @db.Date
  status                PersonStatus        @default(active)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  classTeacherFor       Class[]             @relation("ClassTeacher")
  subjects              Subject[]
  attendance            TeacherAttendance[]

  @@index([status])
  @@map("teachers")
}

model Student {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @unique @map("user_id") @db.Uuid
  admissionNumber   String              @unique @map("admission_number") @db.VarChar(30)
  firstName         String              @map("first_name") @db.VarChar(100)
  lastName          String              @map("last_name") @db.VarChar(100)
  gender            Gender?
  dateOfBirth       DateTime?           @map("date_of_birth") @db.Date
  phone             String?             @db.VarChar(30)
  address           String?             @db.VarChar(500)
  guardianName      String              @map("guardian_name") @db.VarChar(200)
  guardianPhone     String              @map("guardian_phone") @db.VarChar(30)
  classId           String              @map("class_id") @db.Uuid
  admissionDate     DateTime            @map("admission_date") @db.Date
  status            StudentStatus       @default(active)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  user              User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  class             Class               @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendance        StudentAttendance[]
  marks             Mark[]

  @@index([classId])
  @@index([status])
  @@map("students")
}

model Class {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @db.VarChar(50)
  section        String              @db.VarChar(30)
  academicYear   String              @map("academic_year") @db.VarChar(20)
  classTeacherId String?             @map("class_teacher_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  classTeacher   Teacher?            @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students       Student[]
  subjects       Subject[]
  attendance     StudentAttendance[]

  @@unique([name, section, academicYear])
  @@index([classTeacherId])
  @@index([academicYear])
  @@map("classes")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(30)
  classId   String   @map("class_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  class     Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  marks     Mark[]

  @@index([classId])
  @@index([teacherId])
  @@map("subjects")
}

model Exam {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  academicYear String   @map("academic_year") @db.VarChar(20)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  marks        Mark[]

  @@unique([name, academicYear])
  @@index([academicYear])
  @@index([startDate, endDate])
  @@map("exams")
}

model TeacherAttendance {
  id           String                   @id @default(uuid()) @db.Uuid
  teacherId    String                   @map("teacher_id") @db.Uuid
  date         DateTime                 @db.Date
  status       TeacherAttendanceStatus
  checkInTime  DateTime?                @map("check_in_time") @db.Time(0)
  checkOutTime DateTime?                @map("check_out_time") @db.Time(0)
  remarks      String?                  @db.VarChar(500)
  markedBy     String                   @map("marked_by") @db.Uuid
  createdAt    DateTime                 @default(now()) @map("created_at")
  teacher      Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  markedByUser User                     @relation("TeacherAttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: Restrict)

  @@unique([teacherId, date])
  @@index([teacherId])
  @@index([markedBy])
  @@index([date])
  @@map("teacher_attendance")
}

model StudentAttendance {
  id           String                  @id @default(uuid()) @db.Uuid
  studentId    String                  @map("student_id") @db.Uuid
  classId      String                  @map("class_id") @db.Uuid
  date         DateTime                @db.Date
  status       StudentAttendanceStatus
  remarks      String?                 @db.VarChar(500)
  markedBy     String                  @map("marked_by") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at")
  student      Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  class        Class                   @relation(fields: [classId], references: [id], onDelete: Restrict)
  markedByUser User                    @relation("StudentAttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: Restrict)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([classId])
  @@index([markedBy])
  @@index([date])
  @@map("student_attendance")
}

model Mark {
  id             String   @id @default(uuid()) @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  examId         String   @map("exam_id") @db.Uuid
  marksObtained  Decimal  @map("marks_obtained") @db.Decimal(7, 2)
  maxMarks       Decimal  @map("max_marks") @db.Decimal(7, 2)
  grade          String   @db.VarChar(20)
  remarks        String?  @db.VarChar(500)
  enteredBy      String   @map("entered_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  subject        Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Restrict)
  enteredByUser  User     @relation("MarksEnteredBy", fields: [enteredBy], references: [id], onDelete: Restrict)

  @@unique([studentId, subjectId, examId])
  @@index([studentId])
  @@index([subjectId])
  @@index([examId])
  @@index([enteredBy])
  @@map("marks")
}

model GradeScale {
  id                 String   @id @default(uuid()) @db.Uuid
  scaleName          String   @map("scale_name") @db.VarChar(50)
  grade              String   @db.VarChar(20)
  minimumPercentage  Decimal  @map("minimum_percentage") @db.Decimal(5, 2)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([scaleName, grade])
  @@index([scaleName, isActive, minimumPercentage])
  @@map("grade_scales")
}
