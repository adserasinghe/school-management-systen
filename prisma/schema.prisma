generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  teacher
  student

  @@map("user_role")
}

enum Gender {
  male
  female
  other
  prefer_not_to_say

  @@map("gender")
}

enum PersonStatus {
  active
  inactive

  @@map("person_status")
}

enum StudentStatus {
  active
  inactive
  graduated

  @@map("student_status")
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  username         String       @unique @db.VarChar(50)
  email            String       @unique @db.VarChar(255)
  passwordHash     String       @map("password_hash") @db.VarChar(255)
  role             UserRole     @default(admin)
  isActive         Boolean      @default(true) @map("is_active")
  lastLoginAt      DateTime?    @map("last_login_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  teacherProfile   Teacher?
  studentProfile   Student?
  markedAttendance Attendance[] @relation("AttendanceMarkedBy")
  enteredMarks     Mark[]       @relation("MarksEnteredBy")

  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Teacher {
  id                    String       @id @default(uuid()) @db.Uuid
  userId                String       @unique @map("user_id") @db.Uuid
  teacherCode           String       @unique @map("teacher_code") @db.VarChar(30)
  firstName             String       @map("first_name") @db.VarChar(100)
  lastName              String       @map("last_name") @db.VarChar(100)
  gender                Gender?
  dateOfBirth           DateTime?    @map("date_of_birth") @db.Date
  phone                 String?      @db.VarChar(30)
  address               String?      @db.VarChar(500)
  qualification         String?      @db.VarChar(255)
  subjectSpecialization String?      @map("subject_specialization") @db.VarChar(255)
  hireDate              DateTime?    @map("hire_date") @db.Date
  status                PersonStatus @default(active)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  user                  User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  classTeacherFor       Class[]      @relation("ClassTeacher")
  subjects              Subject[]

  @@index([status])
  @@map("teachers")
}

model Student {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String?       @unique @map("user_id") @db.Uuid
  admissionNumber String        @unique @map("admission_number") @db.VarChar(30)
  firstName       String        @map("first_name") @db.VarChar(100)
  lastName        String        @map("last_name") @db.VarChar(100)
  gender          Gender?
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  phone           String?       @db.VarChar(30)
  address         String?       @db.VarChar(500)
  guardianName    String        @map("guardian_name") @db.VarChar(200)
  guardianPhone   String        @map("guardian_phone") @db.VarChar(30)
  classId         String        @map("class_id") @db.Uuid
  admissionDate   DateTime      @default(now()) @map("admission_date") @db.Date
  status          StudentStatus @default(active)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  class           Class         @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendance      Attendance[]
  marks           Mark[]

  @@index([classId])
  @@index([status])
  @@map("students")
}

model Class {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(50)
  section        String       @db.VarChar(30)
  academicYear   String       @map("academic_year") @db.VarChar(20)
  classTeacherId String?      @map("class_teacher_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  classTeacher   Teacher?     @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  students       Student[]
  subjects       Subject[]
  attendance     Attendance[]

  @@unique([name, section, academicYear])
  @@index([classTeacherId])
  @@index([academicYear])
  @@map("classes")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(30)
  classId   String   @map("class_id") @db.Uuid
  teacherId String   @map("teacher_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  class     Class    @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  marks     Mark[]

  @@index([classId])
  @@index([teacherId])
  @@map("subjects")
}

model Attendance {
  id        String    @id @default(uuid()) @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  classId   String    @map("class_id") @db.Uuid
  date      DateTime  @db.Date
  status    String    @db.VarChar(50)
  remarks   String?   @db.VarChar(500)
  markedBy  String?   @map("marked_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  markedByUser User?  @relation("AttendanceMarkedBy", fields: [markedBy], references: [id], onDelete: SetNull)

  @@unique([studentId, date])
  @@index([studentId])
  @@index([classId])
  @@index([markedBy])
  @@index([date])
  @@map("attendance")
}

model Mark {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  exam          String   @default("Term 1") @db.VarChar(100)
  marksObtained Decimal  @map("marks_obtained") @db.Decimal(7, 2)
  maxMarks      Decimal  @default(100) @map("max_marks") @db.Decimal(7, 2)
  grade         String   @db.VarChar(20)
  remarks       String?  @db.VarChar(500)
  enteredBy     String?  @map("entered_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  enteredByUser User?    @relation("MarksEnteredBy", fields: [enteredBy], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, exam])
  @@index([studentId])
  @@index([subjectId])
  @@index([enteredBy])
  @@map("marks")
}
